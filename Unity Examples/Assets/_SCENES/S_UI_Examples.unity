  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Ahim\xE9 non \xE8 successo, infatti ho automatizzato il posizionamento
    usando il component Vertical Layout Group. Questo component va aggiunto al padre
    di tutti gli oggetti che richiedono di essere allineati e li allineer\xE0 in
    verticale. Ne esiste una variente orizzontale e pure una a griglia (anche se
    spesso finisco per doverne codificare di custom poich\xE9 questo sistema ha in
    realt\xE0 fastidiose limitazioni)."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
