  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Gli ancoraggi si trovano nel component Rect Transform dei vari, singoli
    GameObject della UI. Non sono semplicissimi da usare in UI complesse quindi ora
    li spiegher\xF2 a livello 0. Indicano insieme al pivot a quale punto di uno schermo
    ancorare un oggetto.\nCi sono due tipi di ancoraggio:\n- ROSSI: ancoraggi a punto
    singolo - ancorano un oggetto ad un singolo punto, senza mai stretcharlo.\nPer
    questi ancoraggi consiglio di guardare qual \xE8 l'angolo dello schermo pi\xF9
    vicino e ancorare l'oggetto ad esso, spostando anche il pivot in quella direzione.
    Per farlo facilmente: aprite il menu a tendina degli ancoraggi di base in alto
    a sx del rect transform, tenete premuto CTRL + SHIFT e cliccate l'angolo che
    avete scelto. Aggiuster\xE0 sia ancoraggio che pivot in questo modo.\n- BLU:
    ancoraggi stretchabili - quelli complicati ahhh. Allora, questi sono per gli
    oggetti che NON hanno dimensione fissa ma si devono allargare in base allo schermo
    (come una finestra di testo in basso al centro di un JRPG o pokemon). Scegliete
    lungo quale lato vanno applicati, poi CTRL+SHIFT e scegliete l'ancoraggio blu
    corrette (btw li chiamo blu perch\xE9 sono quelli con le frecce blu)."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
