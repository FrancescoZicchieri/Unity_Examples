{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "20d7dc1e1d124634b5a42f1a2495db2b",
    "m_Title": "Output node",
    "m_Content": "Questo doppio nodo rappresenta l'output.\n\nIl Vertex indica la posizione dei vertici del modello 3D. Permette quindi di modificare tramite shader la forma dell'oggetto e può essere un tool estremamente potente ma non facile da usare.\n\nIl Fragment invece è quello definisce il colore dei pixel dell'oggetto (è quello che abbiamo tipicamente usato). Siccome questo shader è di tipo \"unlit\" \"opaco\", presenta solo la proprietà Base Color. Se fosse lit, presenterebbe anche le prorpietà metallic, smothness/roughness e altro.\nChiaramente questo rende lo shader notevolmente più pesante quindi se non servono quelle proprietà unlit e la scelta migliore.",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": 902.4000244140625,
        "y": -352.0,
        "width": 286.4000244140625,
        "height": 586.4000244140625
    },
    "m_Group": {
        "m_Id": ""
    }
}

